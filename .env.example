# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql://username:password@localhost:5432/semantic_search_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=semantic_search_db
POSTGRES_USER=username
POSTGRES_PASSWORD=change_me

# Embeddings: sentence-transformers/all-MiniLM-L6-v2 (384-d, local, default),
# sentence-transformers/all-mpnet-base-v2 (768-d), openai (needs OPENAI_API_KEY),
# or "hashing" (offline lexical backend for tests/demos, no download)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
OPENAI_API_KEY=

API_HOST=127.0.0.1
API_PORT=8000
